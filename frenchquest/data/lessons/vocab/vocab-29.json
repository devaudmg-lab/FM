        "en": "Her presentation impressed the jury."
      }
    },
    {
      "id": "surprendre",
      "kind": "vocab",
      "fr": "surprendre",
      "en": "to surprise; to catch (someone doing)",
      "pos": "verb",
      "example": {
        "fr": "Ta réaction me surprend.",
        "en": "Your reaction surprises me."
      }
    },
    {
      "id": "effrayer",
      "kind": "vocab",
      "fr": "effrayer",
      "en": "to frighten, to scare",
      "pos": "verb",
      "example": {
