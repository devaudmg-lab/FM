    {
      "id": "embeter",
      "kind": "vocab",
      "fr": "embêter",
      "en": "to bother, to annoy",
      "pos": "verb",
      "example": {
        "fr": "Arrête d'embêter ta sœur !",
        "en": "Stop bothering your sister!"
      }
    },
    {
      "id": "se-meler-de",
