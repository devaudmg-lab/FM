        "en": "They rejected my loan application."
      }
    },
    {
      "id": "meriter",
      "kind": "vocab",
      "fr": "mériter",
      "en": "to deserve",
      "pos": "verb",
      "example": {
        "fr": "Tu mérites des vacances !",
        "en": "You deserve a holiday!"
      }
    },
    {
      "id": "souffrir",
      "kind": "vocab",
      "fr": "souffrir",
