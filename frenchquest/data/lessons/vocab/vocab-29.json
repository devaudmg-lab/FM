      }
    },
    {
      "id": "pieger",
      "kind": "vocab",
      "fr": "piéger",
      "en": "to trap, to set up",
      "pos": "verb",
      "example": {
        "fr": "Je me suis fait piéger par une fausse annonce.",
        "en": "I got tricked by a fake ad."
      }
    },
    {
      "id": "tarder",
      "kind": "vocab",
      "fr": "tarder",
      "en": "to delay, to be long (in coming)",
      "pos": "verb",
      "example": {
        "fr": "Le bus tarde à arriver.",
        "en": "The bus is taking a long time to come."
      },
      "note": "Il ne va pas tarder = he will be here soon."
    },
    {
      "id": "se-concentrer",
      "kind": "vocab",
      "fr": "se concentrer",
      "en": "to concentrate, to focus",
      "pos": "verb",
      "accept": [
        "concentrer"
      ],
      "example": {
        "fr": "Je n'arrive pas à me concentrer avec ce bruit.",
        "en": "I can't concentrate with this noise."
      }
    },
    {
      "id": "puer",
      "kind": "vocab",
      "fr": "puer",
      "en": "to stink (informal)",
      "pos": "verb",
      "example": {
        "fr": "Ça pue dans le frigo !",
        "en": "It stinks in the fridge!"
      },
      "note": "Informal. Neutral: sentir mauvais."
    }
