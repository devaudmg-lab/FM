        "en": "The doctor ordered him to rest."
      }
    },
    {
      "id": "cesser",
      "kind": "vocab",
      "fr": "cesser",
      "en": "to stop, to cease",
      "pos": "verb",
      "example": {
        "fr": "Il a cessé de fumer l'année dernière.",
        "en": "He stopped smoking last year."
